<html lang="id">
    <head>
        {{{head}}}
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=info" />
    </head>
    <body class="white-bg">
        {{{nav}}}
        <div class="main md:flex-col-center animate-float-f-b px-6">
            <div class="mx-auto rounded-lg md:flex md:gap-12 md:bg-gray-800 md:p-6">
                <div class="self-center">
                    <h1 class="text-6xl font-bold">Masuk<br /> Ke Event</h1>
                    <p class="mt-1 text-lg text-slate-200">*Untuk Peserta</p>
                </div>
                <div>
                    <form id="sign-up" method="post" action="/join">
                        {{{error}}}
                        <p class="mt-2 mb-3 text-lg font-medium md:mb-1">Masukkan Kode 6 Digit Yang Diberikan oleh Panitia
                        </p>
                        <label for="code" class="auto my-5 block w-full pt-2 pb-4 md:my-2 md:mt-4">
                            <input type="number" class="block w-full min-w-56 rounded-md py-2 text-center text-[40px] font-bold tracking-[.3rem] md:w-[35%]" id="code" name="code" max="999999" placeholder="______" />
                            <p id="error-input" class="mt-2 hidden text-red-500">Code Event berjumlah 6 (enam) digit!</p>
                            <button disabled type="submit" id="button-code" class="btn-main">Lanjutkan</button>
                        </label>
                    </form>
                </div>
            </div>
        </div>
        {{!-- prettier-ignore --}}
        <script>
            const code = document.getElementById('code');
            const button = document.querySelector('#button-code');

            code.addEventListener('input', (e) => {
              code.value = code.value.replace('e', '');
              if (code.value.length < 6 || code.value.length === 0) {
                button.disabled = true;
                if (code.value.length !== 0){
                  code.style.borderColor = '#cf0909'
                  document.getElementById('error-input').classList.remove('hidden')
                };
              } else if (code.value.length > 6) {
                code.value = code.value.slice(0, 6);
              } else{
                button.disabled = false; code.style.borderColor = '#03c203';
                document.getElementById('error-input').classList.add('hidden')
              }
            })
        </script>
        {{{script}}}
    </body>
</html>