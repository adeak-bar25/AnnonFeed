<html lang="id">
    <head>
        {{{head}}}
    </head>
    <body>
        {{{nav}}}
        <div class="main flex-col-center animate-float-f-b px-3">
            <h1 class="max-xs:text-2xl text-center text-4xl font-bold">Terima <span style="color: #933dc9;">Feedback</span> dari acara konfrensi anda dengan mudah</h1>
            <h1 class="max-xs:text-2xl text-center text-4xl font-bold">dengan <span class="brand"><span>Annon</span><span>Feed</span></span>.</h1>
            <div class="my-6 flex justify-center gap-4 max-sm:flex-col sm:gap-[5%] md:mx-auto md:w-max [&_h3]:text-center [&_h3]:text-xl [&_h3]:font-bold">
                <div id="admin" class="max-xs:grid-cols-1 max-xs:grid-rows-[repeat(3,fit-content)] max-xs:[&>h3]:col-span-1 grid grid-cols-2 grid-rows-[repeat(2,fit-content)] md:px-3 [&>a]:mx-3 [&>h3]:col-span-2">
                    <h3>Untuk Panitia</h3>
                    <a href="/new" class="btn-main max-xs:justify-self-center justify-self-end">Buat Sesi Baru</a>
                    <a href="/login" class="btn-main max-xs:justify-self-center justify-self-start">Masuk kembali</a>
                </div>
                <div class="border-sep max-sm:hidden"></div>
                <div id="user">
                    <h3>Untuk Peserta</h3>
                    <a href="/join" class="btn-main mx-auto">Bergabung Dengan Code</a>
                </div>
            </div>
            <div id="info" class="text-center">
                <p>Bingung? Akses bantuan <a href="/help" class="link">disini</a>.</p>
            </div>
        </div>
    </body>
</html>