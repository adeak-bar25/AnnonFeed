<html lang="id">
    <head>
        {{> headHtml title=pageTitle}}
        <script type="text/javascript" src="https://unpkg.com/qr-code-styling@1.5.0/lib/qr-code-styling.js"></script>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=check,close,content_copy,download" />
    </head>
    <body>
        {{> navbar title=pageTitle}}
        <div class="main">
            <section id="at-a-glance" class="bg-secondary-orange px-3 py-5 text-slate-950 md:grid md:grid-flow-row md:grid-cols-2 md:grid-rows-3">
                <h1 id="title" class="text-title text-4xl font-bold">Dashboard</h1>
                <div class="my-3 md:col-start-1 md:row-start-2">
                    <h4 class="text-lg font-bold">Nama Event :</h4>
                    <h1 id="event-name" class="text-3xl font-bold">{{eventName}}</h1>
                </div>
                <div class="mb-3 flex h-fit w-fit flex-col md:col-start-1 md:row-start-3 md:flex-row max-md:[&>*]:py-2 md:[&>*]:px-4 [&>*:first-child]:pl-0">
                    <div class="border-slate-50 max-md:border-b md:border-r">
                        <h4 class="text-sm font-bold">Code :</h4>
                        <h1 class="text-2xl font-bold">{{code}}</h1>
                    </div>
                    <div>
                        <h4 class="text-sm font-bold">Jumlah Feedback :</h4>
                        <h1 class="text-2xl font-bold">{{fblength}}</h1>
                    </div>
                </div>
                <button type="button" id="show-qr" class="mb-4 block w-max rounded-full bg-slate-950 px-4 py-2 text-slate-50 transition-all hover:scale-105 md:hidden">Lihat Qr code</button>
                <div id="qr-container" class="fixed inset-1 z-10 -m-1 hidden items-center justify-center bg-black/65 md:static md:row-span-3 md:flex md:justify-end md:bg-transparent">
                    <div id="qr-box" class="w-fit rounded-md bg-slate-800 p-3 text-slate-50">
                        <div class="material-symbols-rounded cursor-pointer md:!hidden"><span id="close-popup" class="rounded-full p-1 hover:bg-slate-50/30">close</span></div>
                        <div id="qr-canvas" class="m-2 rounded-md bg-[#e4eff8] p-2"></div>
                        <div id="qr-opt" class="text-center [&>*]:rounded-full [&>*]:p-2 [&>*:hover]:bg-slate-50/30">
                            <span class="material-symbols-rounded btn download cursor-pointer" title="Download">download</span>
                            <span class="material-symbols-rounded btn copy-link cursor-pointer" title="Copy Feedback Link to Clipboard">content_copy</span>
                        </div>
                    </div>
                </div>
            </section>
            <div class="scroll-container">
                <div id="scroll-container-header" class="sticky bg-[#321540] px-3 py-1 pt-2">
                    <h3 class="text-xl font-bold">Feedback</h3>
                    <p id="info" style="font-size: 13px; margin: 2px 0 5px 0; color: #ffffffa4; ">*Refresh Page Untuk Memperbarui</p>
                </div>
                <div class="container-main px-3 py-3">
                    {{#each feedbacks}}
                        <div class="feedback">
                            <div class="feedback-content">{{this.feedback}}</div>
                            <div class="feedback-author">
                                Ditulis Oleh
                                <span class="author">{{this.author}}</span>
                            </div>
                        </div>
                    {{/each}}

                </div>
            </div>
        </div>
        {{!-- prettier-ignore --}}
        <script>
            const feedbackUrl = `${window.location.hostname}/feedback?code={{code}}`;
            const qrCode = new QRCodeStyling({
              width: 180,
              height: 180,
              type: "svg",
              data: feedbackUrl,
              image: "favicon.svg",
              dotsOptions: {
                color: "#0c0605",
                type: "rounded"
              },
              backgroundOptions: {
                color: "#e4eff8"
              },
              imageOptions: {
                crossOrigin: "anonymous",
                margin: 5,
                imageSize: 0.4,
              }
            });

            document.getElementById('scroll-container-header').style.top = window.getComputedStyle(document.querySelector('nav.navbar'))['height'];

            qrCode.append(document.getElementById("qr-canvas"));
            const qrContainer = document.getElementById('qr-container');

            document.getElementById('show-qr').addEventListener('click', () => {
              qrContainer.style.display = 'flex';
            });

            qrContainer.addEventListener('click', (e) => {
              if (e.target.id === 'close-popup' || !document.getElementById('qr-box').contains(e.target)) {
                qrContainer.style.display = 'none' };
            });

            document.querySelector('span.download').addEventListener('click', (e) => {
              qrCode.download({ name: "qr", extension: "svg" });
            });

            document.querySelector('span.copy-link').addEventListener('click', function (e) {
              navigator.clipboard.writeText(feedbackUrl)
                .then((v) => {
                  this.textContent = 'check';
                  setTimeout((e) => {
                    this.textContent = 'content_copy' }, 2500)
                })
            });
        </script>
    </body>
</html>